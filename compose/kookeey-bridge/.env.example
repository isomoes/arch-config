# Kookeey SOCKS5 upstreams for the kookeey-bridge stack (passed to gost as -F).
#
# Copy this file to .env (which is gitignored) and fill in your real values:
#
#   cp .env.example .env && $EDITOR .env
#
# Format — PORT is the gateway port Kookeey assigned you (not the local proxy
# port):
#   socks5://USERNAME:PASSWORD@gate.kookeey.info:PORT
KOOKEEY_UPSTREAM=socks5://USERNAME:PASSWORD@gate.kookeey.info:PORT
KOOKEEY_UPSTREAM_10012=socks5://USERNAME:PASSWORD@gate.kookeey.info:PORT
KOOKEEY_UPSTREAM_10013=socks5://USERNAME:PASSWORD@gate.kookeey.info:PORT
